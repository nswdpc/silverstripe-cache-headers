{
    "name": "nswdpc/silverstripe-cache-headers",
    "description": "Modify cache headers via configuration",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "caching",
        "cache-control",
        "cloudflare"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "James Ellis",
            "role": "Developer"
        }
    ],
    "require": {
        "silverstripe/cms" : "^5"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "phpunit/phpunit": "^9.5",
        "cambis/silverstan": "^2",
        "nswdpc/ci-files": "dev-v-4",
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "rector/rector": "^2"
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\Utilities\\Cache\\": [
                "src/Control/Middleware/",
                "src/Extensions/",
                "src/Models/",
                "src/Services/"
            ],
            "NSWDPC\\Utilities\\Cache\\Tests\\": [
                "tests/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
